# Copy this file to .env only for local development.
# Never commit a real .env, and never put a real secret in this example.
#
# The app needs none of these to run its tools. They are optional.

# Backend bind port. The UI is always loopback-only.
KWS_PORT=8788

# Optional: URL of a prebuilt runtime rootfs image to download on first run.
# Leave empty to use a locally built image at runtime/dist/kalisub-rootfs.tar.
KWS_ROOTFS_URL=

# Expected SHA-256 of the image above. Mandatory if KWS_ROOTFS_URL is set.
KWS_ROOTFS_SHA256=

# Optional default AI provider: none | ollama | openai (OpenAI-compatible).
KWS_AI_PROVIDER=none
KWS_AI_BASE_URL=

# Do NOT put a real API key here. Keys are entered inside the app and stored
# with Windows DPAPI under your own user profile. The example below is a
# placeholder so secret scanners can be shown to recognise the pattern.
KWS_AI_API_KEY=REPLACE_ME_NOT_A_REAL_KEY
