# Optional settings, for reference. Every value has a safe default and the app
# needs none of them to run its tools.
#
# KaliDesk does NOT read a .env file (there is no loader in the code). To use a
# value, set it as a real environment variable in the shell that starts the app,
# for example in PowerShell:
#
#   $env:KWS_PORT = "8899"
#   python app/main.py
#
# Never put a real secret in this file or in the repository. The AI provider
# keys are not set here at all: enter them inside the app (Settings > AI
# provider), where they are stored with Windows DPAPI under your user profile.

# Backend port on 127.0.0.1. A bad value falls back to 8788. --port overrides it.
KWS_PORT=8788

# Name of the private WSL2 distribution the app creates and manages.
# Default: KaliSubstitute. The app never touches any other distribution.
KWS_DISTRO=KaliSubstitute

# URL of the in-runtime agent, as seen from Windows. Default: http://127.0.0.1:5055
KWS_AGENT_URL=http://127.0.0.1:5055

# Optional: URL of a pinned runtime image (.tar.gz) to download in Set up runtime.
# Leave empty to use the official Kali WSL image, or a local
# runtime/dist/kalisub-rootfs.tar.gz if you built one.
KWS_ROOTFS_URL=

# Required if KWS_ROOTFS_URL is set: the expected SHA-256 of that file, as 64 hex
# characters. The app refuses to import the image if the hash does not match.
KWS_ROOTFS_SHA256=

# Optional: base URL that the official image is downloaded from.
# Default: https://kali.download/wsl-images/current/
KWS_ROOTFS_BASE=

# Optional: full path to wsl.exe, if it is not on PATH. Default: wsl.exe
KWS_WSL_EXE=

# Optional: where the app keeps its database, secrets, evidence and work folders.
# Default: %LOCALAPPDATA%\KaliWindowsSubstitute
KWS_DATA_DIR=

# Development only: the practice target (Playground) folder and port inside the
# runtime. Defaults: /tmp/kalisub-playground and 3000. Leave these alone unless
# you are testing the Playground.
KWS_PLAYGROUND_ROOT=
KWS_PLAYGROUND_PORT=
